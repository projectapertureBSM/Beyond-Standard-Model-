def explore_sigma_variation(particle_name, num_sigmas=10):
    """Explores the impact of varying sigma on HFI."""
    M = particle_data[particle_name]
    r = np.linspace(0, 5, 500)
    sigmas = np.linspace(0.1, 5, num_sigmas)  # Explore sigma values

    hfi_values = []
    for sigma in sigmas:
        HFI_value, h, pc_h, density = hfi_with_radial_density(M, r, sigma)
        hfi_values.append(HFI_value)
        print(f"Sigma: {sigma:.2f}, HFI: {HFI_value:.6f}")

    #Plotting
    plt.plot(sigmas, hfi_values)
    plt.xlabel("Sigma")
    plt.ylabel("HFI Value")
    plt.title(f"{particle_name}: HFI vs. Sigma")
    plt.grid(True)
    plt.show()


def check_hfi_sensitivity(particle_name, delta_sigma=0.1):
    """Checks the sensitivity of HFI to small changes in sigma."""
    M = particle_data[particle_name]
    r = np.linspace(0, 5, 500)
    sigma = 1.0  #Base sigma value

    HFI_base, h, pc_h, density = hfi_with_radial_density(M, r, sigma)
    HFI_perturbed, h, pc_h, density = hfi_with_radial_density(M, r, sigma + delta_sigma)
    sensitivity = (HFI_perturbed - HFI_base) / delta_sigma

    print(f"{particle_name}: HFI Sensitivity to sigma (delta_sigma={delta_sigma}): {sensitivity:.6f}")


def test_lifetime_sigma_hypothesis(particle_name):
    """Tests if smaller lifetime values have smaller sigma values"""
    M = particle_data[particle_name]
    r = np.linspace(0, 5, 500)

    h = harmonic_distance(M)
    lifetime = lifetime_function(h)
    #Hypothesis: sigma is inversely proportional to abs(lifetime)
    sigma = 1 / (abs(lifetime) + 0.1) #avoid divide by zero
    HFI_value, h, pc_h, density = hfi_with_radial_density(M, r, sigma)

    print(f"{particle_name}: Lifetime: {lifetime}, Estimated Sigma: {sigma}, HFI: {HFI_value}")

