# Functions (from the document)
def harmonic_distance(M):
    """Calculates the harmonic distance (h) for a particle of mass M."""
    return np.log2(MH / M)


def pythagorean_comma_correction(h):
    """Calculates the Pythagorean Comma Correction (PC(h))."""
    return (MH/1000) * (PYTHAGOREAN_COMMA**(np.floor(h / 12)) - 1) # Scale MH down by 1000 because the output is too high


def force_definitions(h, pc_h):
    """Calculates the trigonometric force definitions."""
    Q = np.sin(2 * np.pi * h) - np.cos(2 * np.pi * h) - np.tan(2 * np.pi * h) + pc_h
    Gg = np.cos(2 * np.pi * h) + 1/np.cos(2 * np.pi * h) + pc_h
    Gem = np.sin(2 * np.pi * h) * np.cos(2 * np.pi * h) + 1/np.sin(2 * np.pi * h) + pc_h
    Gs = np.sin(2 * np.pi * h) * np.tan(2 * np.pi * h) + 1/np.tan(2 * np.pi * h) + pc_h
    Gw = np.cos(2 * np.pi * h) * np.tan(2 * np.pi * h) + 1/np.cos(2 * np.pi * h) + pc_h
    return Q, Gg, Gem, Gs, Gw


def mass_scaled_forces(M, Q, Gg, Gem, Gs, Gw):
    """Calculates the mass-scaled forces."""
    lam = M / MH
    FQ = lam * Q
    FGg = lam * Gg
    FGem = lam * Gem
    FGs = lam * Gs
    FGw = lam * Gw
    return FQ, FGg, FGem, FGs, FGw


def hfi(FQ, FGg, FGem, FGs, FGw, pc_h):
    """Calculates the Harmonic Force Interaction (HFI)."""
    return FQ + FGg + FGem + FGs + FGw + 5*pc_h #added 5pc_h based on equation 11


def lifetime_function(h):
    """Calculates the lifetime function (τ(h))."""
    return np.sin(2 * np.pi * h) - np.tan(2 * np.pi * h)


# Radial Density Calculation (Gaussian Example)
def radial_density(r, h, sigma):
    """
    Calculates a Gaussian radial density distribution.

    Args:
        r (np.ndarray): Array of radial distances.
        h (float): Harmonic distance (influences the distribution).
        sigma (float): Standard deviation (controls the width of the distribution).

    Returns:
        np.ndarray: Array of radial density values.
    """
    # The harmonic distance can influence the sigma to connect
    # it with the particle's properties.  This is just an example.
    sigma_eff = sigma * (1 + abs(h)/10)  # Example: sigma is scaled by h

    return (1 / (sigma_eff * np.sqrt(2 * np.pi))) * np.exp(-0.5 * (r / sigma_eff)**2)


# Function to calculate the HFI with radial density influence
def hfi_with_radial_density(M, r, sigma):
    """Calculates HFI incorporating the radial density distribution."""
    h = harmonic_distance(M)
    pc_h = pythagorean_comma_correction(h)
    Q, Gg, Gem, Gs, Gw = force_definitions(h, pc_h)
    FQ, FGg, FGem, FGs, FGw = mass_scaled_forces(M, Q, Gg, Gem, Gs, Gw)

    # Calculate radial density and use it to "weight" the forces
    density = radial_density(r, h, sigma)
    #Example: Weight forces based on integrated density
    integrated_density = np.trapezoid(density, r)

    #Here is where the code weighs the function, this equation will have to be written based on the relation
    weighted_FQ = FQ * integrated_density
    weighted_FGg = FGg * integrated_density
    weighted_FGem = FGem * integrated_density
    weighted_FGs = FGs * integrated_density
    weighted_FGw = FGw * integrated_density

    HFI_value = hfi(weighted_FQ, weighted_FGg, weighted_FGem, weighted_FGs, weighted_FGw, pc_h)

    return HFI_value, h, pc_h, density


